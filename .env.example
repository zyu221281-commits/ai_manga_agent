# 环境变量模板（含预算配置）
# 复制为 .env 并填入实际 API Key

# === 基础设施（本地 Docker）===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=mydb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# === LLM API ===
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# === 图像生成 ===
FLUX_API_KEY=
FAL_API_KEY=
ARK_API_KEY=

# === 视频生成 ===
KLING_API_KEY=
RUNWAY_API_KEY=
VE_API_KEY=

# === TTS ===
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
VOLCENGINE_TTS_KEY=

# === 内容安全 ===
ALIYUN_SAFETY_KEY=

# === 推文 API ===
FANQIE_API_KEY=
QUARK_API_KEY=

# === 分发平台 ===
DOUYIN_OPEN_KEY=
BILIBILI_OPEN_KEY=
YOUTUBE_API_KEY=
KUAISHOU_OPEN_KEY=

# === 预算配置（USD）===
COST_BUDGET_PER_EPISODE_USD=1.5
COST_DAILY_CAP_USD=15.0
COST_MONTHLY_CAP_USD=300.0
COST_ALERT_THRESHOLD=0.8
COST_HARD_STOP_THRESHOLD=1.0

# === 视频分级策略 ===
VIDEO_KEY_SCENE_RATIO=0.20
VIDEO_KEY_SCENE_MODEL=kling
VIDEO_AB_TEST_ENABLED=true

# === Critic 质量门 ===
CRITIC_PASS_THRESHOLD=0.8
CRITIC_REVIEW_THRESHOLD=0.6
CRITIC_MAX_RETRY=2
CRITIC_HUMAN_REVIEW_TIMEOUT_H=4

# === 应用配置 ===
APP_ENV=development
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=

# === 视频内容质检 ===
# VIDEO_CONTENT_CHECK_ENABLED=true   # 是否启用视频内容质检
# VIDEO_CONTENT_CHECK_CLIP_THRESHOLD=0.72  # 视频帧与源图 CLIP 相似度阈值
# VIDEO_CONTENT_CHECK_VLM_ENABLED=true     # KEY_SCENE 是否启用 VLM 人物完整性检查
# VIDEO_POLL_MAX_WAIT_S=600         # Seedance 任务轮询最大等待秒数
